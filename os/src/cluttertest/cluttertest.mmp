// cluttertest.mmp -- the Clutter feasibility test (docs hildon-port.md 7.33): Clutter 1.26 + Cogl 1.22 (libclutter.a, libcogl*.a, libjson-glib.a, recipes/build_*_x32.sh) statically linked, on GLib / Pango / Cairo DLLs
// and the GLES2 / EGL front DLLs; the WSERV window is Cogl's native window (cluttertest.cpp: phe_cogl_native_window).
TARGET			cluttertest.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7015798
CAPABILITY		all -tcb
VENDORID		0
EPOCHEAPSIZE	0x100000 0x8000000
EPOCSTACKSIZE	0x100000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			cluttertest.cpp
LIBRARY			euser.lib ws32.lib libc.lib libm.lib libpthread.lib pheglib.lib phegobject.lib phegmodule.lib phegthread.lib phepango.lib phecairo.lib pheatk.lib libEGL.lib libGLESv2.lib
SMPSAFE
